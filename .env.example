# Copy to .env.local and fill in. Never commit real values.
# .env.local is ignored by git.
#
# For local development, leave GYM_SECRET and BLOB_READ_WRITE_TOKEN empty:
# data goes to .data/ and the login screen is off.

# Password for the login screen, and the value of the `x-gym-secret` header for
# scripted calls. Use a long random string. Empty turns auth off (local use only).
GYM_SECRET=

# Optional. A second secret that works only as an `x-gym-secret` header on
# GET /api/session/<id> and GET /api/program, for read-only tools. Empty disables it.
GYM_READ_SECRET=

# Vercel Blob read-write token. When set, data is stored in Vercel Blob instead of
# .data/. Do not load a real token while running `npm run dev`: it would read and
# write your real workouts.
BLOB_READ_WRITE_TOKEN=

# Access mode of the Blob store: private or public. Default: private.
# Must match how the store was created in Vercel.
BLOB_ACCESS=private

# Optional. A link template for a "Coach" button in the header of an open
# session. {sessionId} is replaced with the session id. Leave empty to hide it.
# Example: https://coach.example.com/review?session={sessionId}
# Compiled into the client bundle, so set it before `npm run build` (or as a
# Docker build argument), not only at run time.
NEXT_PUBLIC_COACH_URL=
